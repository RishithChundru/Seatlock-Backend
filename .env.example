# Copy to .env for local overrides (.env is git-ignored). In production set these as
# environment variables / secrets on the host (Render), never commit real values.
# Every variable is optional locally: the defaults match docker-compose.yml.

# --- PostgreSQL (Neon) ---
# Neon gives a postgresql:// URL with user and password inside. Spring needs the JDBC form
# jdbc:postgresql://<HOST>/<DATABASE>?sslmode=require  with user and password in the two lines below.
DB_URL=jdbc:postgresql://localhost:5432/seatlock
DB_USER=seatlock
DB_PASSWORD=seatlock

# --- Redis (Upstash) --- use rediss:// (TLS) for Upstash
REDIS_URL=redis://localhost:6379

# --- RabbitMQ (CloudAMQP) --- use the amqps:// URL from CloudAMQP
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Security ---
# At least 32 random bytes. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-it-must-be-32-bytes+
# Admin login, created the first time the app starts on an empty database. Pick your own values.
# Leave ADMIN_PASSWORD empty locally to have a random one printed in the startup log instead.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Frontend origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000
# Where links in emails point (your frontend)
FRONTEND_URL=http://localhost:3000

# Auth cookies over HTTPS only. Must be true in production; leave false for http://localhost.
# COOKIE_SECURE=false
# Password for /actuator/prometheus (user "prometheus"). Empty = endpoint closed.
# METRICS_TOKEN=

# --- Cover images in S3-compatible storage (optional) ---
# Leave commented out to keep covers in Postgres. Local S3Mock: docker compose --profile storage up -d
# S3_BUCKET=seatlock-images
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000/seatlock-images
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Email (SMTP) ---
# Leave these commented out locally: the app then sends to Mailpit from docker-compose (inbox: http://localhost:8025).
# For production, set them as secrets on the host only, never here. Provider setup: DEPLOY.md, "Email".
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=
# SMTP_STARTTLS=
# MAIL_FROM=
