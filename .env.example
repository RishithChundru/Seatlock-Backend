# Copy to .env for local overrides (.env is git-ignored). In production set these as
# environment variables / secrets on the host (Render), never commit real values.
# Every variable is optional locally: the defaults match docker-compose.yml.

# --- PostgreSQL (Neon) ---
# Neon shows: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# JDBC form:  jdbc:postgresql://HOST/DB?sslmode=require   (user and password go below)
DB_URL=jdbc:postgresql://localhost:5432/seatlock
DB_USER=seatlock
DB_PASSWORD=seatlock

# --- Redis (Upstash) --- use rediss:// (TLS) for Upstash
REDIS_URL=redis://localhost:6379

# --- RabbitMQ (CloudAMQP) --- use the amqps:// URL from CloudAMQP
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Security ---
# At least 32 random bytes. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-it-must-be-32-bytes+
# Password for admin@seatlock.dev, set when the database is first seeded
ADMIN_PASSWORD=Admin@12345
# Frontend origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000
